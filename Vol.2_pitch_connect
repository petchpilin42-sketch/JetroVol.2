    // Antigravity Engine
    class AntigravityEngine {
      constructor() {
        this.isZeroG = false;
        this.engine = null;
        this.runner = null;
        this.loopId = null;
        this.items = [];
        this.ghosts = [];
        this.audioCtx = null;
        this.init();
      }

      init() {
        const toggleBtn = document.getElementById('btn-toggle-ag');
        const restoreBtn = document.getElementById('btn-restore');
        if (toggleBtn) toggleBtn.addEventListener('click', () => this.toggle());
        if (restoreBtn) restoreBtn.addEventListener('click', () => this.restore());
      }

      playTone(freq, type = 'sine', duration = 0.2) {
        try {
          if (!this.audioCtx) this.audioCtx = new (window.AudioContext || window.webkitAudioContext)();
          if (this.audioCtx.state === 'suspended') this.audioCtx.resume();

          const osc = this.audioCtx.createOscillator();
          const gain = this.audioCtx.createGain();

          osc.type = type;
          osc.frequency.setValueAtTime(freq, this.audioCtx.currentTime);
          gain.gain.setValueAtTime(0.05, this.audioCtx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, this.audioCtx.currentTime + duration);

          osc.connect(gain);
          gain.connect(this.audioCtx.destination);
          osc.start();
          osc.stop(this.audioCtx.currentTime + duration);
        } catch (e) {}
      }

      engage() {
        if (this.isZeroG) return;
        this.isZeroG = true;

        this.playTone(523.25, 'triangle', 0.35);

        this.engine = Matter.Engine.create({
          gravity: { x: 0, y: 0, scale: 0.001 }
        });
        this.runner = Matter.Runner.create();

        const w = window.innerWidth;
        const h = window.innerHeight;
        const pad = 80;
        const wallOpts = { isStatic: true, restitution: 0.85 };

        const walls = [
          Matter.Bodies.rectangle(w / 2, -pad / 2, w * 2, pad, wallOpts),
          Matter.Bodies.rectangle(w / 2, h + pad / 2, w * 2, pad, wallOpts),
          Matter.Bodies.rectangle(-pad / 2, h / 2, pad, h * 2, wallOpts),
          Matter.Bodies.rectangle(w + pad / 2, h / 2, pad, h * 2, wallOpts)
        ];
        Matter.Composite.add(this.engine.world, walls);

        const mouse = Matter.Mouse.create(document.body);
        const mouseConstraint = Matter.MouseConstraint.create(this.engine, {
          mouse: mouse,
          constraint: { stiffness: 0.2, render: { visible: false } }
        });
        Matter.Composite.add(this.engine.world, mouseConstraint);

        const targets = document.querySelectorAll('[data-ag]');
        this.items = [];
        this.ghosts = [];

        targets.forEach((el) => {
          const rect = el.getBoundingClientRect();

          const ghost = document.createElement('div');
          ghost.style.width = `${rect.width}px`;
          ghost.style.height = `${rect.height}px`;
          ghost.style.visibility = 'hidden';
          ghost.style.pointerEvents = 'none';
          el.parentNode.insertBefore(ghost, el);
          this.ghosts.push({ ghost, el });

          const body = Matter.Bodies.rectangle(
            rect.left + rect.width / 2,
            rect.top + rect.height / 2,
            rect.width,
            rect.height,
            {
              restitution: 0.75,
              frictionAir: 0.02,
              density: 0.001
            }
          );

          const fx = (Math.random() - 0.5) * 0.012;
          const fy = (Math.random() - 0.7) * 0.012;
          Matter.Body.applyForce(body, body.position, { x: fx, y: fy });
          Matter.Composite.add(this.engine.world, body);

          el.classList.add('ag-floating');
          el.style.width = `${rect.width}px`;
          el.style.height = `${rect.height}px`;
          el.style.left = '0px';
          el.style.top = '0px';

          this.items.push({ el, body, rect });
        });

        Matter.Events.on(this.engine, 'collisionStart', () => {
          this.playTone(220 + Math.random() * 80, 'sine', 0.08);
        });

        Matter.Runner.run(this.runner, this.engine);

        const loop = () => {
          if (!this.isZeroG) return;
          const t = performance.now() * 0.001;

          this.items.forEach(({ el, body, rect }) => {
            Matter.Body.applyForce(body, body.position, {
              x: Math.sin(t + body.id) * 0.00018,
              y: Math.cos(t * 0.8 + body.id) * 0.00018
            });

            const x = body.position.x - rect.width / 2;
            const y = body.position.y - rect.height / 2;
            el.style.transform = `translate3d(${x}px, ${y}px, 0px) rotate(${body.angle}rad)`;
          });

          this.loopId = requestAnimationFrame(loop);
        };
        this.loopId = requestAnimationFrame(loop);

        const toggleText = document.getElementById('btn-toggle-text');
        const statusEl = document.getElementById('ag-status');
        const indicator = document.getElementById('ag-indicator');
        if (toggleText) toggleText.innerText = 'Restore 1.0G';
        if (statusEl) {
          statusEl.innerText = '0.0G (ZERO-G ACTIVE)';
          statusEl.className = 'text-xs font-bold text-rose-400 animate-pulse font-mono';
        }
        if (indicator) {
          indicator.className = 'w-2.5 h-2.5 rounded-full bg-rose-500 animate-ping';
        }
      }

      restore() {
        if (!this.isZeroG) return;
        this.isZeroG = false;

        this.playTone(392.00, 'sine', 0.2);

        if (this.loopId) cancelAnimationFrame(this.loopId);
        Matter.Runner.stop(this.runner);
        Matter.World.clear(this.engine.world, false);

        this.items.forEach(({ el, rect }) => {
          el.style.transition = 'transform 0.65s cubic-bezier(0.16, 1, 0.3, 1)';
          el.style.transform = `translate3d(${rect.left}px, ${rect.top}px, 0px) rotate(0rad)`;

          setTimeout(() => {
            el.classList.remove('ag-floating');
            el.removeAttribute('style');
          }, 650);
        });

        setTimeout(() => {
          this.ghosts.forEach(({ ghost }) => ghost.remove());
          this.ghosts = [];
          this.items = [];
        }, 650);

        const toggleText = document.getElementById('btn-toggle-text');
        const statusEl = document.getElementById('ag-status');
        const indicator = document.getElementById('ag-indicator');
        if (toggleText) toggleText.innerText = 'Zero-G Mode';
        if (statusEl) {
          statusEl.innerText = '1.0G (NORMAL)';
          statusEl.className = 'text-xs font-bold text-emerald-400 font-mono hidden sm:inline';
        }
        if (indicator) {
          indicator.className = 'w-2.5 h-2.5 rounded-full bg-emerald-400';
        }
      }

      toggle() {
        this.isZeroG ? this.restore() : this.engage();
      }
    }

    window.addEventListener('DOMContentLoaded', () => {
      window.ag = new AntigravityEngine();
    });
  </script>
</body>
</html>
