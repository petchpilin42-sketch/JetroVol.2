    /* Diagonal Hero Flag Graphic */
    .hero-flag-panel {
      background: var(--grad-flag);
      clip-path: polygon(14% 0, 100% 0, 86% 100%, 0% 100%);
      box-shadow: -10px 18px 36px rgba(103, 105, 164, 0.28);
      position: relative;
    }

    .flag-shard {
      position: absolute;
      background: rgba(255, 255, 255, 0.22);
      backdrop-filter: blur(4px);
      border: 1px solid rgba(255, 255, 255, 0.35);
    }

    /* Physics & Zero-G Target Elements */
    .ag-target {
      transform-origin: center center;
      backface-visibility: hidden;
      will-change: transform;
      user-select: none;
    }

    .ag-floating {
      position: fixed !important;
      z-index: 9990 !important;
      cursor: grab;
      box-shadow: 0 24px 48px -10px rgba(14, 38, 70, 0.35), 0 0 25px rgba(193, 35, 31, 0.25);
    }
    .ag-floating:active {
      cursor: grabbing;
    }

    /* Deadline Divider Component */
    .deadline-divider {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 16px;
      margin: 32px 0;
    }
    .deadline-divider::before,
    .deadline-divider::after {
      content: '';
      flex: 1;
      height: 1.5px;
      background: var(--red-600);
    }
    .deadline-label {
      color: var(--red-600);
      font-family: 'Poppins', 'Noto Sans JP', sans-serif;
      font-weight: 700;
      font-size: 13.5px;
      letter-spacing: 0.04em;
      white-space: nowrap;
    }

    /* Time Chip Component */
    .time-chip {
      background: #FFFFFF;
      border: 1.5px solid var(--navy-900);
      color: var(--navy-900);
      border-radius: var(--radius-sm);
      font-family: 'Poppins', sans-serif;
      font-weight: 700;
      font-size: 13.5px;
      padding: 6px 14px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 135px;
      box-shadow: 0 2px 4px rgba(14,38,70,0.05);
    }

    /* Feature Circle */
    .feature-circle {
      width: 140px;
      height: 140px;
      border-radius: 50%;
      background: #FFFFFF;
      border: 2px solid var(--border-100);
      box-shadow: 0 8px 24px rgba(14, 38, 70, 0.07);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      margin: 0 auto 16px;
      position: relative;
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }
    .feature-circle:hover {
      transform: scale(1.05);
      box-shadow: 0 12px 28px rgba(14, 38, 70, 0.12);
    }

    /* Card Micro-interactions */
    .interactive-card {
      transition: all 0.2s ease;
    }
    .interactive-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 25px -4px rgba(14, 38, 70, 0.1);
    }

    /* Modal Backdrop */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(14, 38, 70, 0.6);
      backdrop-filter: blur(8px);
      z-index: 10000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 16px;
    }
    .modal-backdrop.active {
      display: flex;
    }

